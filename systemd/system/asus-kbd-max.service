[Unit]
Description=Set ASUS keyboard backlight to max
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/bin/bash -lc 'test -e /sys/class/leds/asus::kbd_backlight/max_brightness && cat /sys/class/leds/asus::kbd_backlight/max_brightness > /sys/class/leds/asus::kbd_backlight/brightness'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
